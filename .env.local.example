# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real key here.
#
#   cp .env.local.example .env.local
#
# The WebSocket URL from Alchemy already contains your API key as its last
# path segment. Treat the whole URL as the secret.

TAPELINE_ONCHAIN_ENABLED=true
TAPELINE_ONCHAIN_CHAIN=ethereum
TAPELINE_ONCHAIN_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE
