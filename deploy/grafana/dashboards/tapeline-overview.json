{
  "uid": "tapeline-overview",
  "title": "Tapeline \u2014 pipeline overview",
  "description": "Ingestion, stream processing and serving on one page. Panels are ordered the way data flows, so a problem can be walked from the venue socket to the client stream without changing dashboards.",
  "tags": [
    "tapeline",
    "market-data"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 100,
      "title": "Ingestion",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 101,
      "title": "Events ingested",
      "type": "timeseries",
      "description": "Received is what the decoders produced; published is what Kafka acknowledged. A sustained gap between them means events are being dropped as duplicates or failing to encode.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(tapeline_ingest_events_received_total[1m])) by (venue)",
          "legendFormat": "{{venue}} received",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(tapeline_ingest_events_published_total[1m]))",
          "legendFormat": "published to Kafka",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 102,
      "title": "Source lag (venue event time to local receipt)",
      "type": "timeseries",
      "description": "The honest measure of data staleness, and the panel to watch during chaos testing. Recovery time after a killed broker is read off this.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(tapeline_ingest_source_lag_seconds_bucket[1m])) by (le, venue))",
          "legendFormat": "p50 {{venue}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(tapeline_ingest_source_lag_seconds_bucket[1m])) by (le, venue))",
          "legendFormat": "p99 {{venue}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 103,
      "title": "Venue connections",
      "type": "timeseries",
      "description": "1 while the socket is up. Reconnect spikes across all three venues at once are a local network problem, not an exchange problem.",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "tapeline_ingest_connection_up",
          "legendFormat": "{{venue}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(increase(tapeline_ingest_reconnects_total[5m])) by (venue)",
          "legendFormat": "reconnects {{venue}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 104,
      "title": "Sequence integrity",
      "type": "timeseries",
      "description": "Missed messages mean the order book downstream is rebuilt from incomplete deltas. Duplicates dropped here are duplicates Flink never has to hold state for.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(tapeline_ingest_sequence_messages_missed_total[5m])) by (venue)",
          "legendFormat": "messages missed {{venue}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(tapeline_ingest_duplicates_dropped_total[5m])) by (venue)",
          "legendFormat": "duplicates dropped {{venue}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 105,
      "title": "Kafka publish latency",
      "type": "timeseries",
      "description": "The write call itself. If this rises with source lag, Kafka is the bottleneck rather than the venue.",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(tapeline_ingest_publish_latency_seconds_bucket[1m])) by (le, topic))",
          "legendFormat": "p99 {{topic}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 106,
      "title": "Decode and publish errors",
      "type": "timeseries",
      "description": "Single decode errors are normal. A sustained rate means a venue changed its message format.",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(tapeline_ingest_decode_errors_total[5m])) by (venue)",
          "legendFormat": "decode {{venue}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(tapeline_ingest_publish_errors_total[5m]))",
          "legendFormat": "publish",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 107,
      "title": "Stream processing",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 108,
      "title": "Checkpoint duration vs timeout",
      "type": "timeseries",
      "description": "The panel that drove the split away from the monolithic job. When duration approaches timeout, state has outgrown the current parallelism. See docs/DESIGN_DECISIONS.md#d2.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flink_jobmanager_job_lastCheckpointDuration",
          "legendFormat": "{{job_name}} duration",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "flink_jobmanager_job_checkpointTimeout",
          "legendFormat": "{{job_name}} timeout",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 109,
      "title": "Failed checkpoints",
      "type": "timeseries",
      "description": "Exactly-once output depends on checkpoints completing: the Kafka sink commits its transaction only when a checkpoint does. Failing checkpoints mean committed output has stopped even though the job looks healthy.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "increase(flink_jobmanager_job_numberOfFailedCheckpoints[5m])",
          "legendFormat": "{{job_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 110,
      "title": "Records in and out per operator",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_numRecordsInPerSecond[1m])) by (operator_name)",
          "legendFormat": "in {{operator_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_numRecordsOutPerSecond[1m])) by (operator_name)",
          "legendFormat": "out {{operator_name}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 111,
      "title": "Crossed books",
      "type": "timeseries",
      "description": "Best bid at or above best ask is not a market condition. It means deltas were applied out of order or a resync was missed, and the affected quotes are suppressed rather than served.",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_tapeline_book_crossed_books[5m]))",
          "legendFormat": "crossed",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_tapeline_book_quotes_suppressed[5m]))",
          "legendFormat": "quotes suppressed",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 112,
      "title": "Serving",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 113,
      "title": "gRPC latency",
      "type": "timeseries",
      "description": "The p99 that goes in the resume bullet comes from here, measured under the k6 load profile in loadtest/k6.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(grpc_server_processing_duration_seconds_bucket[1m])) by (le, grpc_method))",
          "legendFormat": "p50 {{grpc_method}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(grpc_server_processing_duration_seconds_bucket[1m])) by (le, grpc_method))",
          "legendFormat": "p99 {{grpc_method}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 114,
      "title": "Streaming subscribers and drops",
      "type": "timeseries",
      "description": "Dropping is the designed response to a subscriber that cannot keep up: the next quote supersedes the last, so the freshest price beats a backlog of stale ones.",
      "gridPos": {
        "x": 8,
        "y": 31,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "tapeline_serving_stream_subscribers",
          "legendFormat": "subscribers",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(tapeline_serving_stream_dropped_total[1m]))",
          "legendFormat": "dropped for slow clients",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 115,
      "title": "Quote pipeline into the cache",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 31,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(tapeline_serving_quotes_consumed_total[1m]))",
          "legendFormat": "consumed",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(tapeline_serving_quotes_failed_total[1m]))",
          "legendFormat": "failed to decode",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 116,
      "title": "End-to-end freshness: venue event time to quote emit",
      "type": "timeseries",
      "description": "The two ends of the pipeline on one axis. Their sum bounds how stale a served quote can be, which is the number a client actually cares about.",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(tapeline_serving_quotes_processing_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99 serving-side processing",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(tapeline_ingest_source_lag_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99 ingestion lag",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "venue",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(tapeline_ingest_events_received_total, venue)",
        "multi": true,
        "includeAll": true,
        "refresh": 1
      }
    ]
  }
}
